diff --git a/sbin/setFORx-gfortran.sou b/sbin/setFORx-gfortran.sou
new file mode 100644
index 0000000..58227b4
--- /dev/null
+++ b/sbin/setFORx-gfortran.sou
@@ -0,0 +1,8 @@
+# gfortran has no environment-variable logical-unit mapping (unlike
+# ifort's FORTnn or PGI's FORnnn): pre-connect units with fort.NN
+# symlinks in the current directory instead.
+# 2026 Jul 24 - added for the gfortran port
+set FORTYPE = symlink
+alias FORxxx $BIN/FORxxx -gfortran
+alias setFOR   'ln -sf \!\!:2 fort.\!\!:1'
+alias unsetFOR 'rm -f fort.\!\!:1'
